NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Local development database (Docker Postgres). Used by `prisma migrate dev`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/daystackup?schema=public

# Local development only: sync the authenticated Supabase user into the local
# `auth.users` stub so the user_id foreign keys can be satisfied. Never set this
# when DATABASE_URL points at a real Supabase database.
LOCAL_AUTH_BOOTSTRAP=1

# Supabase connection string. Prefer the Session Pooler (IPv4) from
# Supabase -> Connect -> Session pooler. The direct host
# (db.[YOUR-PROJECT-REF].supabase.co) is IPv6-only and fails with
# P1001 "Network is unreachable" on IPv4-only networks.
# Deploy with: npm run db:deploy
SUPABASE_DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
